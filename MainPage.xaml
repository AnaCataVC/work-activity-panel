<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WorkActivityPanel.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkActivityPanel"
    xmlns:models="using:WorkActivityPanel.Models"
    xmlns:vm="using:WorkActivityPanel.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}" 
                               Style="{StaticResource TitleLargeTextBlockStyle}" 
                               FontSize="44" FontWeight="SemiLight" VerticalAlignment="Center"/>

                    <!-- Calendar Synced Badge -->
                    <Border Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" 
                            CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"
                            Visibility="{x:Bind ViewModel.IsGoogleConnected, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE787;" FontSize="14" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock Text="Calendario conectado" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.CurrentDate, Mode=OneWay}" 
                           Style="{StaticResource SubtitleTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <FontIcon Glyph="{x:Bind ViewModel.WorkStatusIcon, Mode=OneWay}" FontSize="18" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.WorkStatus, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock Text="•" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="{x:Bind ViewModel.WorkScheduleDisplay, Mode=OneWay}" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                <Button Command="{x:Bind ViewModel.RefreshStatusCommand}" ToolTipService.ToolTip="Actualizar estado">
                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                </Button>
                
                <Button Click="SettingsButton_Click" ToolTipService.ToolTip="Ajustes y Configuración">
                    <FontIcon Glyph="&#xE713;" FontSize="16"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24">

                <!-- Upcoming Meeting Banner (Fires 5 min prior to meetings) -->
                <InfoBar Title="Próxima reunión en 5 minutos"
                         Message="{x:Bind ViewModel.UpcomingMeetingTitle, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.ShowUpcomingMeetingBanner, Mode=OneWay}"
                         Severity="Warning"
                         IsClosable="True"
                         CloseButtonClick="InfoBar_CloseButtonClick">
                    <InfoBar.ActionButton>
                        <Button Content="Abrir Granola" Command="{x:Bind ViewModel.OpenGranolaCommand}" Style="{StaticResource AccentButtonStyle}"/>
                    </InfoBar.ActionButton>
                </InfoBar>

                <!-- Quick Controls: Vacation Mode -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE709;" FontSize="20" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <StackPanel>
                                <TextBlock Text="Modo Vacaciones" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                <TextBlock Text="Pausa la apertura automática de Slack y Granola" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        <ToggleSwitch HorizontalAlignment="Right" VerticalAlignment="Center" 
                                      IsOn="{x:Bind ViewModel.IsVacationMode, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Application Status Section -->
                <StackPanel Spacing="12">
                    <TextBlock Text="Aplicaciones de Trabajo" Style="{StaticResource SubtitleTextBlockStyle}" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Slack Card -->
                        <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE8F1;" FontSize="22"/>
                                        <TextBlock Text="Slack" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.SlackStatusColor, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.SlackStatusText, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Button Grid.Row="1" Content="Abrir Slack" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.OpenSlackCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Granola Card -->
                        <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                
                                <Grid Grid.Row="0">
                                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7EE;" FontSize="22"/>
                                        <TextBlock Text="Granola" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.GranolaStatusColor, Mode=OneWay}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind ViewModel.GranolaStatusText, Mode=OneWay}" 
                                                   Style="{StaticResource CaptionTextBlockStyle}" 
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Grid>
                                
                                <Button Grid.Row="1" Content="Abrir Granola" Margin="0,16,0,0" HorizontalAlignment="Stretch"
                                        Command="{x:Bind ViewModel.OpenGranolaCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- Today's Schedule & Meetings (Google Calendar) -->
                <StackPanel Spacing="12">
                    <Grid>
                        <TextBlock Text="Reuniones de Hoy" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center"/>
                        <TextBlock Text="Google Calendar" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                   Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="18">
                        <StackPanel Spacing="12">
                            <!-- When meetings exist -->
                            <ItemsControl ItemsSource="{x:Bind ViewModel.TodayMeetings, Mode=OneWay}"
                                          Visibility="{x:Bind ViewModel.HasMeetings, Mode=OneWay}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:CalendarEvent">
                                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Time -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="80">
                                                    <TextBlock Text="{x:Bind FormattedStartTime}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                                                    <TextBlock Text="{x:Bind FormattedEndTime}" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Title -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0">
                                                    <TextBlock Text="{x:Bind Title}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="Granola se abrirá 5 min antes" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                </StackPanel>

                                                <!-- Join Link Button -->
                                                <Button Grid.Column="2" Content="Unirme a la reunión" VerticalAlignment="Center"
                                                        Click="JoinMeeting_Click" Tag="{x:Bind MeetingLink}"
                                                        Visibility="{x:Bind MeetingLink, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Visible}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- When no meetings or not connected -->
                            <StackPanel HorizontalAlignment="Center" Spacing="8" Margin="0,16"
                                        Visibility="{x:Bind ViewModel.HasMeetings, Mode=OneWay, Converter={StaticResource InverseBoolToVisibilityConverter}, FallbackValue=Visible}">
                                <FontIcon Glyph="&#xE787;" FontSize="28" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="No tienes reuniones programadas para hoy." Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
