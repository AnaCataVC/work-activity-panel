<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WorkActivityPanel.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WorkActivityPanel"
    xmlns:vm="using:WorkActivityPanel.ViewModels"
    xmlns:models="using:WorkActivityPanel.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent">

    <Grid Padding="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="0,0,0,24">
            <Button Click="BackButton_Click" Style="{StaticResource NavigationBackButtonNormalStyle}" />
            <TextBlock Text="Ajustes y Configuración" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="24" MaxWidth="680" HorizontalAlignment="Left">
                
                <!-- Save Confirmation InfoBar -->
                <InfoBar Title="Configuración guardada"
                         Message="{x:Bind ViewModel.SaveConfirmationMessage, Mode=OneWay}"
                         IsOpen="{x:Bind ViewModel.ShowSaveConfirmation, Mode=TwoWay}"
                         Severity="Success"
                         IsClosable="True" />

                <!-- Schedule Settings & Vacation Mode -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Horario Laboral" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Hora de Inicio" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TimePicker Time="{x:Bind ViewModel.WorkStartTime, Mode=TwoWay}" />
                                </StackPanel>
                                
                                <StackPanel Grid.Column="1" Spacing="8">
                                    <TextBlock Text="Hora de Fin" Style="{StaticResource BodyTextBlockStyle}" />
                                    <TimePicker Time="{x:Bind ViewModel.WorkEndTime, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Días Laborales" Margin="0,8,0,0" Style="{StaticResource BodyTextBlockStyle}" />
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Row="0" Grid.Column="0" Content="Lunes" IsChecked="{x:Bind ViewModel.IsMonday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="0" Grid.Column="1" Content="Martes" IsChecked="{x:Bind ViewModel.IsTuesday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="0" Grid.Column="2" Content="Miércoles" IsChecked="{x:Bind ViewModel.IsWednesday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="0" Content="Jueves" IsChecked="{x:Bind ViewModel.IsThursday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="1" Content="Viernes" IsChecked="{x:Bind ViewModel.IsFriday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="1" Grid.Column="2" Content="Sábado" IsChecked="{x:Bind ViewModel.IsSaturday, Mode=TwoWay}" Margin="0,0,16,8"/>
                                <CheckBox Grid.Row="2" Grid.Column="0" Content="Domingo" IsChecked="{x:Bind ViewModel.IsSunday, Mode=TwoWay}" Margin="0,0,16,8"/>
                            </Grid>

                            <!-- Vacation Mode under Work Schedule -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,4,0,0">
                                <StackPanel Spacing="4">
                                    <ToggleSwitch Header="Modo Vacaciones" 
                                                  IsOn="{x:Bind ViewModel.IsVacationMode, Mode=TwoWay}" />
                                    <TextBlock Text="Pausa la apertura de aplicaciones y alertas mientras estés de vacaciones"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,-8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Google Calendar iCal Integration -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Google Calendar" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Copia la 'Secret address in iCal format' de Google Calendar y pégala aquí para sincronizar tus reuniones." 
                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBox Header="Dirección secreta iCal (.ics)"
                                     Text="{x:Bind ViewModel.CalendarICalUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://calendar.google.com/calendar/ical/.../basic.ics" />

                            <!-- Filters & Granola Automation Rules -->
                            <Expander Header="Filtros y reglas de apertura de Granola" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                                <StackPanel Spacing="14" Padding="0,12,0,0">
                                    <TextBlock Text="Configura qué eventos deben abrir Granola 5 minutos antes. Los eventos excluidos permanecerán visibles en tu itinerario pero sin activar la automatización de Granola ni mostrar avisos emergentes."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap" />

                                    <TextBox Header="Palabras clave o prefijos a ignorar (separados por coma)"
                                             Text="{x:Bind ViewModel.CalendarExcludedKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="[Personal], [Privado], Out of office, Fuera de la oficina, OOO, Vacaciones, Focus time" />

                                    <ToggleSwitch Header="Ignorar eventos de día completo (vacaciones/OOO)" 
                                                  IsOn="{x:Bind ViewModel.CalendarIgnoreAllDayEvents, Mode=TwoWay}" />

                                    <ToggleSwitch Header="Solo abrir si tiene enlace de videollamada (Meet, Teams, Zoom, Webex)" 
                                                  IsOn="{x:Bind ViewModel.CalendarRequireMeetingLink, Mode=TwoWay}" />
                                </StackPanel>
                            </Expander>

                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0" VerticalAlignment="Center">
                                <Button Content="Guardar y Sincronizar" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveCalendarUrlCommand}" />

                                <Button Content="Desconectar"
                                        Command="{x:Bind ViewModel.ClearCalendarUrlCommand}"
                                        Visibility="{x:Bind ViewModel.IsCalendarConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}"/>

                                <TextBlock Text="{x:Bind ViewModel.CalendarConnectionStatus, Mode=OneWay}" 
                                           VerticalAlignment="Center" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Google Drive Backup Integration -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Copia de Seguridad en Google Drive" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Sincroniza tus carpetas de trabajo hacia Google Drive mediante una Web App de Google Apps Script sin requerir clientes de terceros ni proyectos GCP." 
                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <TextBox Header="URL de la Web App de Google Apps Script (/exec)"
                                     Text="{x:Bind ViewModel.DriveWebAppUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://script.google.com/macros/s/.../exec" />

                            <PasswordBox Header="Token de autorización secreto (opcional)"
                                         Password="{x:Bind ViewModel.DriveAuthToken, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="Token configurado en tu Apps Script para autorizar subidas" />

                            <TextBox Header="URL de la carpeta de Google Drive (para el botón «Abrir Drive»)"
                                     Text="{x:Bind ViewModel.DriveFolderUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="https://drive.google.com/drive/folders/..." />

                            <!-- Test Connection & Status -->
                            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0" VerticalAlignment="Center">
                                <Button Content="Probar Conexión"
                                        Command="{x:Bind ViewModel.TestDriveConnectionCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsDriveTesting, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />

                                <ProgressRing IsActive="{x:Bind ViewModel.IsDriveTesting, Mode=OneWay}" Width="16" Height="16" />

                                <TextBlock Text="{x:Bind ViewModel.DriveConnectionStatus, Mode=OneWay}" 
                                           VerticalAlignment="Center" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- Sync Sources: every folder lands at the same level in Drive -->
                            <StackPanel Spacing="12" Margin="0,8,0,0">
                                <TextBlock Text="Carpetas a sincronizar" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="Cada carpeta local se respalda en una subcarpeta propia de Google Drive, todas al mismo nivel. Si dejas el nombre vacío se usa el de la carpeta local."
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap" />

                                <ItemsControl ItemsSource="{x:Bind ViewModel.DriveSyncSources, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:SyncSource">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                                <Grid ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Spacing="4">
                                                        <TextBlock Text="{x:Bind LocalFolderPath}" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="Subcarpeta en Drive:" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBox Text="{x:Bind DestinationPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="32" Padding="6,2" PlaceholderText="ej: mi-proyecto" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" ToolTipService.ToolTip="Eliminar carpeta"
                                                            Tag="{x:Bind}"
                                                            Click="DeleteSourceButton_Click"
                                                            VerticalAlignment="Center">
                                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Click="AddSourceFolderButton_Click" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                                        <TextBlock Text="Agregar carpeta..." />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Agent Instructions CLAUDE.md Sweep -->
                            <Expander Header="Instrucciones de Agentes (CLAUDE.md sin versionar)" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                                <StackPanel Spacing="14" Padding="0,12,0,0">
                                    <ToggleSwitch Header="Respaldar archivos CLAUDE.md huérfanos/sin versionar"
                                                  IsOn="{x:Bind ViewModel.DriveSyncUnversionedClaudeMarkdown, Mode=TwoWay}" />
                                    <TextBlock Text="Rastrea automáticamente en tu perfil de usuario archivos CLAUDE.md que no pertenezcan a repositorios Git para respaldarlos en Google Drive."
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Margin="0,-8,0,0"
                                               TextWrapping="Wrap" />

                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Grid.Column="0" Header="Prefijo de destino en Drive"
                                                 Text="{x:Bind ViewModel.DriveClaudeMarkdownDestinationPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="claude-md-unversioned" />
                                        <NumberBox Grid.Column="1" Header="Profundidad"
                                                   Value="{x:Bind ViewModel.DriveClaudeMarkdownScanDepth, Mode=TwoWay}"
                                                   Minimum="1" Maximum="15" SpinButtonPlacementMode="Inline" />
                                    </Grid>
                                </StackPanel>
                            </Expander>

                            <!-- Filters & AutoSync Options -->
                            <Expander Header="Filtros y opciones avanzadas de sincronización" HorizontalAlignment="Stretch" Margin="0,8,0,0">
                                <StackPanel Spacing="14" Padding="0,12,0,0">
                                    <TextBox Header="Extensiones permitidas (Whitelist, opcional ej: .pdf, .docx, .xlsx)"
                                             Text="{x:Bind ViewModel.DriveIncludedExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Dejar vacío para incluir todos los tipos permitidos" />

                                    <TextBox Header="Extensiones ignoradas (Blacklist)"
                                             Text="{x:Bind ViewModel.DriveExcludedExtensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText=".tmp, .log, .exe, .bak, .zip" />

                                    <TextBox Header="Carpetas ignoradas"
                                             Text="{x:Bind ViewModel.DriveExcludedFolders, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="node_modules, .git, bin, obj, .vs, temp" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleSwitch Grid.Column="0" Header="Sincronización Incremental (SHA-256)" 
                                                      IsOn="{x:Bind ViewModel.DriveOnlyModifiedOrNew, Mode=TwoWay}" />
                                        <ToggleSwitch Grid.Column="1" Header="Auto-sync al terminar jornada" 
                                                      IsOn="{x:Bind ViewModel.DriveAutoSyncOnWorkEnd, Mode=TwoWay}" />
                                    </Grid>

                                    <!-- Hash Index Cache Reset -->
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <Grid ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Restablecer Caché de Hashes" 
                                                    Command="{x:Bind ViewModel.ClearHashIndexCommand}" />
                                            <TextBlock Grid.Column="1" 
                                                       Text="Limpia el registro local de hashes para forzar una re-evaluación y sincronización completa en la próxima ejecución."
                                                       Style="{StaticResource CaptionTextBlockStyle}"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Expander>

                            <Button Content="Guardar Ajustes de Google Drive" Style="{StaticResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.SaveDriveSettingsCommand}" HorizontalAlignment="Right" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- GitHub CLI & Accounts Configuration -->
                <StackPanel Spacing="16">
                    <TextBlock Text="GitHub CLI y Cuentas" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <TextBlock Text="Configura qué cuenta de GitHub corresponde a tu cuenta laboral y personal para alternar automáticamente según tu horario de trabajo." 
                                       Style="{StaticResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,8,0">
                                    <TextBlock Text="Cuenta Laboral" Style="{StaticResource BodyTextBlockStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableGitHubAccounts, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.GitHubWorkAccount, Mode=TwoWay}"
                                              IsEditable="True"
                                              Text="{x:Bind ViewModel.GitHubWorkAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Ej. CataVillalobosC" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Spacing="8" Margin="8,0,0,0">
                                    <TextBlock Text="Cuenta Personal (opcional)" Style="{StaticResource BodyTextBlockStyle}" />
                                    <ComboBox ItemsSource="{x:Bind ViewModel.AvailableGitHubAccounts, Mode=OneWay}"
                                              SelectedItem="{x:Bind ViewModel.GitHubPersonalAccount, Mode=TwoWay}"
                                              IsEditable="True"
                                              Text="{x:Bind ViewModel.GitHubPersonalAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Stretch"
                                              PlaceholderText="Ej. AnaCataVC" />
                                </StackPanel>
                            </Grid>

                            <!-- Automation Toggles -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                <StackPanel Spacing="12">
                                    <ToggleSwitch Header="Cambiar automáticamente a la cuenta laboral al iniciar la jornada" 
                                                  IsOn="{x:Bind ViewModel.GitHubAutoSwitchOnWorkStart, Mode=TwoWay}" />
                                    <ToggleSwitch Header="Cambiar automáticamente a la cuenta personal al finalizar la jornada" 
                                                  IsOn="{x:Bind ViewModel.GitHubAutoSwitchOnWorkEnd, Mode=TwoWay}" />
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,4,0,0">
                                <TextBlock Text="{x:Bind ViewModel.GitHubSettingsStatus, Mode=OneWay}" 
                                           VerticalAlignment="Center" 
                                           Style="{StaticResource CaptionTextBlockStyle}" 
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <Button Content="Guardar Ajustes de GitHub" Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.SaveGitHubSettingsCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- General Settings -->
                <StackPanel Spacing="16">
                    <TextBlock Text="General" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="16">
                            <ToggleSwitch Header="Iniciar con Windows" 
                                          IsOn="{x:Bind ViewModel.IsAutostartEnabled, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- About & Updates Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="Acerca de y Actualizaciones" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="20">
                        <StackPanel Spacing="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4">
                                    <TextBlock Text="{x:Bind ViewModel.AppVersionText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}" 
                                               Style="{StaticResource CaptionTextBlockStyle}" 
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Buscar Actualizaciones"
                                            Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                            IsEnabled="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                                    <Button Content="Actualizar Ahora" Style="{StaticResource AccentButtonStyle}"
                                            Command="{x:Bind ViewModel.DownloadAndInstallUpdateCommand}"
                                            Visibility="{x:Bind ViewModel.IsUpdateAvailable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                            IsEnabled="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource InverseBoolConverter}}" />
                                </StackPanel>
                            </Grid>
                            <ProgressBar Value="{x:Bind ViewModel.DownloadProgress, Mode=OneWay}" Maximum="100" 
                                         Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button Content="Guardar Todo" Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.SaveSettingsCommand}" HorizontalAlignment="Right" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

